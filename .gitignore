# Dependencies
node_modules/

# Builds
dist/
frontend/dist/

# Cloudflare / Wrangler local state
.wrangler/
.dev.vars

# D1 dumps (plan P3-5). Never committed: a dump is the whole database — every user row, every
# PBKDF2 hash, every audit log. Backups belong in the offsite store BACKUP-AND-RECOVERY.md names,
# not in a git history that is cloned onto every machine that ever touches this project.
.backups/
wrangler.drill.toml

# Environment
.env
.env.local
.env.*.local

# Vitest browser mode (the `browser` project in frontend/vite.config.ts). A failing test in real
# Chrome writes a screenshot of the page at the moment it failed; both directories are diagnostic
# output from a run, not fixtures. `__screenshots__` lands beside the test file rather than in a
# build directory, so without this a red run leaves untracked PNGs inside `src/`.
frontend/.vitest-attachments/
**/__screenshots__/

# Editor / OS
.DS_Store
Thumbs.db
*.log

.dev.vars*
!.dev.vars.example
!.env.example
